{
  "name": "stride-ops",
  "version": "0.1.0",
  "description": "AI-native FPS game engine built on Three.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "format": "prettier --write 'src/**/*.ts'",
    "docs": "typedoc --out docs/api src",
    "demo:build": "webpack --config webpack.config.cjs --mode production",
    "demo:dev": "webpack serve --config webpack.config.cjs --mode development",
    "deploy:gh-pages": "npm run demo:build && npx gh-pages -d dist-demo",
    "deploy:netlify": "npm run demo:build && npx netlify deploy --prod --dir=dist-demo",
    "deploy:netlify:draft": "npm run demo:build && npx netlify deploy --dir=dist-demo",
    "typecheck": "tsc --noEmit",
    "demo:preview": "npx serve dist-demo"
  },
  "dependencies": {
    "three": "^0.162.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@webgpu/types": "^0.1.71",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.7",
    "typescript": "^5.3.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6",
    "@types/three": "^0.162.0"
  },
  "private": true
}
